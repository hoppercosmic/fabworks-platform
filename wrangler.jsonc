{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fabworks",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fabworks-db",
      "database_id": "84dbe74d-c6ff-4c90-8996-91598ef284f6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "fabworks-photos"
    }
  ]
}
